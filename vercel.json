{
  "builds": [
    {
      "src": "api/index.go",
      "use": "@vercel/go",
      "config": {
        "includeFiles": ["views/**"]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.go"
    },
    {
      "src": "/personal-quiz(/.*)?",
      "dest": "/api/index.go"
    },
    {
      "src": "/anon-box(/.*)?",
      "dest": "/api/index.go"
    },
    {
      "src": "/anon/(.*)",
      "dest": "/api/index.go"
    }
  ]
}
